# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ==========================================
# Database (MySQL via Prisma)
# ==========================================
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/guest_house"

# ==========================================
# JWT Authentication
# ==========================================
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CORS
# ==========================================
FRONTEND_URL=http://localhost:3001

# ==========================================
# Cloudinary (production image storage)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# Rate limiting
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5

# ==========================================
# Seed (optional overrides)
# ==========================================
SEED_ADMIN_EMAIL=admin@guesthouse.com
SEED_ADMIN_PASSWORD=Admin@12345
