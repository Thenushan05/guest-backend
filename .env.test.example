# ==========================================
# E2E Test Environment (.env.test)
# ==========================================
# Copy this file to .env.test and fill in your dedicated test database URL.
# NEVER commit .env.test with real secrets.
#
# Usage:
#   1. Create a separate MySQL database: CREATE DATABASE guest_house_test;
#   2. Fill in DATABASE_URL below
#   3. Run: npx prisma migrate deploy --env-file .env.test
#   4. Run: npx dotenv -e .env.test -- ts-node prisma/seed.ts
#   5. Run: npm run test:e2e

NODE_ENV=test
PORT=3001
API_PREFIX=api/v1

# ==========================================
# Test Database (separate from dev/prod!)
# ==========================================
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/guest_house_test"

# ==========================================
# JWT — use short expiry so token-expiry
# tests run fast without mocking time
# ==========================================
JWT_ACCESS_SECRET=e2e-test-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=e2e-test-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CORS (not enforced in test; any origin OK)
# ==========================================
FRONTEND_URL=http://localhost:3001

# ==========================================
# Cloudinary — leave empty in tests.
# Image upload e2e tests will be skipped
# automatically when these are absent.
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# Rate limiting — set high so tests don't
# get throttled on rapid repeated requests
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=1000

# ==========================================
# Seed credentials (used by auth.helper.ts)
# ==========================================
SEED_ADMIN_EMAIL=admin@guesthouse.com
SEED_ADMIN_PASSWORD=Admin@12345
